{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "users": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.admin === true)",
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || data.child('ownerUid').val() === auth.uid || root.child('admins').child(auth.uid).exists() || auth.token.admin === true)",
        ".write": "auth != null && ($userId.matches(/^[6-9][0-9]{9}$/) || $userId === auth.uid) && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid && newData.child('ownerUid').val() === data.child('ownerUid').val()) || root.child('admins').child(auth.uid).exists() || auth.token.admin === true)",
        ".validate": "newData.hasChildren(['userName', 'mobileNumber', 'registrationTime', 'timerStartTime', 'timerExpiryTime', 'timerStatus'])",
        "userName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
        },
        "mobileNumber": {
          ".validate": "newData.isString() && newData.val().matches(/^[6-9][0-9]{9}$/)"
        },
        "ownerUid": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "registrationTime": {
          ".validate": "newData.isNumber() && newData.val() <= now + 5000"
        },
        "timerStartTime": {
          ".validate": "newData.isNumber() && newData.val() <= now + 5000"
        },
        "timerExpiryTime": {
          ".validate": "newData.isNumber() && newData.val() <= newData.parent().child('timerStartTime').val() + 120000"
        },
        "timerStatus": {
          ".validate": "newData.isString() && newData.val().matches(/^(active|expired)$/)"
        },
        "connectionStatus": {
          ".validate": "newData.isString() && newData.val().matches(/^(online|offline)$/)"
        },
        "isOnline": {
          ".validate": "newData.isBoolean()"
        },
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "networkAvailable": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "smsPermissionStatus": {
          ".validate": "newData.isString() && newData.val().matches(/^(Granted|Permission Denied|Not Available)$/)"
        },
        "notificationPermissionStatus": {
          ".validate": "newData.isString() && newData.val().matches(/^(Granted|Permission Denied|Not Available|Not Requested)$/)"
        }
      }
    }
  }
}
